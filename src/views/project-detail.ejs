<%- include('partials/header') %>
<main>
    <h2><%= project.title %></h2>
    <p><strong>Organization:</strong> <%= project.organization_name %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><%= project.description %></p>

    <div class="tags" style="margin-top: 15px;">
        <strong>Categories: </strong>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <a href="/category/<%= cat.category_id %>" style="margin-right: 8px; padding: 3px 8px; background: #e0e0e0; border-radius: 4px; text-decoration: none;">
                    #<%= cat.name %>
                </a>
            <% }); %>
        <% } else { %>
            <span>None</span>
        <% } %>
    </div>
</main>
<%- include('partials/footer') %>