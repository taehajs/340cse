<%- include('partials/header') %>

<main>
    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Date:</strong> <%= project.date %></p>

    <div class="category-tags" style="margin-top: 20px;">
        <strong>Categories:</strong>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <a href="/categories/<%= category.category_id %>" 
                   style="display: inline-block; background-color: #e0e0e0; padding: 4px 8px; border-radius: 4px; margin-right: 5px; text-decoration: none; color: #333;">
                    #<%= category.name %>
                </a>
            <% }); %>
        <% } else { %>
            <span>Uncategorized</span>
        <% } %>
    </div>

    <a href="/projects" style="display: inline-block; margin-top: 20px;">← Back to All Projects</a>
</main>

<%- include('partials/footer') %>