<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>
    <p>We collaborate with various organizations to make a difference in our community.</p>
    
    <div class="organization-list" style="margin-top: 20px;">
        <% organizations.forEach(organization => { %>
            <section class="org-item" style="margin-bottom: 30px;">
                <h3><%= organization.name %></h3>
                <p><%= organization.description %></p>
                <p>Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" style="max-width: 250px; height: auto; border-radius: 4px;">
            </section>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>