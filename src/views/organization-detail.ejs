<%- include('partials/header') %>
<main>
    <h2><%= organization.name %></h2>
    <p><%= organization.description %></p>
    <p><strong>Contact:</strong> <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>

    <h3 style="margin-top: 30px;">Service Projects Hosted by <%= organization.name %></h3>
    <ul class="project-list" style="margin-top: 15px;">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li style="margin-bottom: 15px;">
                    <a href="/project/<%= project.project_id %>" style="font-size: 1.1rem; font-weight: bold;">
                        <%= project.title %>
                    </a>
                    <p style="margin: 4px 0;"><%= project.description %></p>
                    <small>Date: <%= new Date(project.date).toLocaleDateString() %> | Location: <%= project.location %></small>
                </li>
            <% }); %>
        <% } else { %>
            <p>No service projects found for this organization.</p>
        <% } %>
    </ul>

    <a href="/organizations" style="display: inline-block; margin-top: 20px;">← Back to Organizations List</a>
</main>
<%- include('partials/footer') %>