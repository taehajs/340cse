<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>

    <div class="project-list" style="margin-top: 20px;">
        <% projects.forEach(project => { %>
            <section class="project-item" style="margin-bottom: 25px;">
                <h3>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </h3>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
                <% if (project.organization_name) { %>
                    <p><strong>Organization:</strong> 
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                <% } %>
            </section>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>