<%- include('partials/header') %>

<main>
    <h2>Service Project Categories</h2>
    <p>Explore our projects by browsing through the service categories below:</p>

  
    <div class="actions" style="margin-bottom: 1rem;">
        <a href="/new-category" class="btn btn-primary">+ Add New Category</a>
    </div>

    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                    
              
                    <span class="edit-link" style="margin-left: 10px;">
                        (<a href="/edit-category/<%= category.category_id %>">Edit</a>)
                    </span>
                </li>
            <% }); %>
        <% } else { %>
            <li>No categories found in database.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>