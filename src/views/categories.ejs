<%- include('partials/header') %>

<main>
    <h2>Service Project Categories</h2>
    <p>Explore our projects by browsing through the service categories below:</p>

    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }); %>
        <% } else { %>
            <li>No categories found in database.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>