<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Project Categories - CSE 340</title>
</head>
<body>
    <header>
        <h1>CSE 340 Web Development</h1>
        <nav>
            <a href="/">Home</a> | 
            <a href="/organizations">Organizations</a> | 
            <a href="/projects">Projects</a> | 
            <a href="/categories">Categories</a>
        </nav>
        <hr>
    </header>
    
    <main>
        <h2>Service Project Categories</h2>
        <p>Explore our projects by browsing through the service categories below:</p>
        
        <ul>
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach(category => { %>
                    <li><strong><%= category.name %></strong></li>
                <% }); %>
            <% } else { %>
                <li>No categories found in database.</li>
            <% } %>
        </ul>
    </main>
    
    <hr>
    <footer>
        <p>© 2026 CSE 340 Assignment. All rights reserved.</p>
    </footer>
</body>
</html>